# =========================================================================
# منصة أراضينا - إعدادات الاتصال بـ Google Firebase
# =========================================================================
# للحصول على هذه المفاتيح:
# 1. افتح موقع Firebase Console: https://console.firebase.google.com/
# 2. أنشئ مشروعاً جديداً باسم (aradhina-foncier)
# 3. اضغط على أيقونة الويب (Web App </>) وسجل التطبيق
# 4. انسخ بيانات firebaseConfig وضعها في هذا الملف:

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aradhina-foncier.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aradhina-foncier
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aradhina-foncier.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
