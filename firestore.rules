rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المشرف: بريد موثّق (سجّل الدخول بـ Google) ضمن القائمة.
    // يجب أن تطابق القائمة ADMIN_EMAILS في src/lib/admin.ts
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['abdouking74@gmail.com'];
    }

    // ملف المستخدم: يقرأه صاحبه أو المشرف، وينشئه بباقة free فقط.
    // لا يستطيع المستخدم تعديل باقته بنفسه؛ التفعيل من لوحة المشرف فقط.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow update: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == 'free'
        && request.resource.data.planExpiresAt == null;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.planExpiresAt == resource.data.planExpiresAt;
      allow delete: if false;
    }

    // طلبات الاشتراك: يُنشئها أي زائر، ويقرؤها ويحدّث حالتها المشرف فقط.
    match /subscription_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'fullName','phone','wilaya','userRole','email','planName',
          'planId','uid','accountEmail','submittedAt','status'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 30;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // القوانين والمناشير: قراءة عامة، والكتابة للمشرف فقط.
    match /algerian_laws/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
